@model RacingDays.Web.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register Account";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark">Join RacingDays</h3>
                    <p class="text-muted small">Create an account to host or register for races</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label font-weight-bold">Full Name</label>
                        <input asp-for="Name" class="form-control rounded-pill px-3" placeholder="e.g. Sipho Nkosi" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label font-weight-bold">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control rounded-pill px-3" placeholder="name@example.com" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label font-weight-bold">Password</label>
                        <input asp-for="Password" type="password" class="form-control rounded-pill px-3" required />
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="Age" class="form-label font-weight-bold">Age</label>
                            <input asp-for="Age" type="number" class="form-control rounded-pill px-3" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="Contact" class="form-label font-weight-bold">Contact No</label>
                            <input asp-for="Contact" class="form-control rounded-pill px-3" placeholder="0821234567" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="RoleId" class="form-label font-weight-bold">Account Type</label>
                        <select asp-for="RoleId" class="form-select rounded-pill px-3">
                            <option value="2">Participant (Runner / Cyclist)</option>
                            <option value="1">Organiser (Host Race Events)</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 py-2 rounded-pill fw-bold shadow-sm mb-3">Create Account</button>

                    <div class="text-center">
                        <small class="text-muted">Already have an account? <a asp-action="Login" class="text-dark font-weight-bold">Sign In</a></small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>