<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RacingDays</title>
    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Dark Glassmorphism Header Navbar -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-custom px-4 py-3 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold fs-4" asp-controller="Participant" asp-action="Index">
                    <i class="bi bi-flag-fill me-2 text-lime"></i><span class="brand-off-white">RACING</span><span class="text-lime">DAYS</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Participant" asp-action="Index">
                                <i class="bi bi-compass me-1"></i> Explore Events
                            </a>
                        </li>
                        @if (Context.Session.GetString("UserRole") == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-lime fw-semibold" asp-controller="Organiser" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Organiser Dashboard
                                </a>
                            </li>
                        }
                    </ul>
                    <!-- Authentication State -->
                    <ul class="navbar-nav">
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserName")))
                        {
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="text-white fw-bold"><i class="bi bi-person-circle me-1 text-lime"></i> @Context.Session.GetString("UserName")</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Logout">Sign Out</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-lime btn-sm px-3" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-lime btn-sm px-3" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main View Body -->
    <div class="container flex-grow-1 my-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Dark Footer -->
    <footer class="py-4 text-center mt-auto">
        <div class="container">
            <small class="text-muted">&copy; 2026 - <strong>RacingDays</strong>. All rights reserved.</small>
        </div>
    </footer>

    <!-- Bootstrap 5 JavaScript Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Safe Custom Client-Side JavaScript Enhancements -->
    <script>
            document.addEventListener("DOMContentLoaded", function() {
                // 1. Auto-dismiss flash alert banners after 4 seconds
                setTimeout(function() {
                    let alerts = document.querySelectorAll('.alert-dismissible');
                    alerts.forEach(alert => {
                        let bsAlert = new bootstrap.Alert(alert);
                        bsAlert.close();
                    });
                }, 4000);

                // 2. Client-side Live Table Filter (Safe JS helper)
                const searchInput = document.getElementById("tableSearchInput");
                if (searchInput) {
                    searchInput.addEventListener("keyup", function() {
                        const filter = searchInput.value.toLowerCase();
                        const rows = document.querySelectorAll(".table-dark-custom tbody tr");
                        rows.forEach(row => {
                            const text = row.textContent.toLowerCase();
                            row.style.display = text.includes(filter) ? "" : "none";
                        });
                    });
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>