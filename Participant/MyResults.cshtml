@model List<RacingDays.Web.Models.ParticipantResultViewModel>

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container my-5" style="max-width: 900px;">
    <h2 class="fw-bold text-off-white mb-4"><i class="bi bi-trophy text-lime me-2"></i>My Race Results & History</h2>

    <div class="card card-dark overflow-hidden p-4">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-dark-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Race Event</th>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Position</th>
                            <th>Finish Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Model)
                        {
                            <tr>
                                <td><strong class="text-off-white">@res.EventName</strong></td>
                                <td>@res.EventDate.ToString("MMM dd, yyyy")</td>
                                <td><span class="badge badge-lime">@res.CategoryName</span></td>
                                <td><span class="badge bg-warning text-dark fw-bold px-3 py-2">#@res.Position</span></td>
                                <td><code class="text-lime fw-bold fs-6">@res.FinishTime.ToString(@"hh\:mm\:ss")</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted-slate mb-0">No official finish times recorded yet. Complete an event to see your race standings here!</p>
            </div>
        }
    </div>
</div>