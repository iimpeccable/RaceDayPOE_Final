@model RacingDays.Web.Models.EventViewModel

@{
    ViewData["Title"] = Model?.Name ?? "Event Details";
}

<div class="container my-5" style="max-width: 1000px;">
    <a asp-action="Index" class="btn btn-outline-lime mb-4">
        <i class="bi bi-arrow-left me-1"></i> Back to Directory
    </a>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-dark border-lime text-lime alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger bg-dark border-danger text-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card card-dark overflow-hidden shadow-lg">
        <div class="position-relative" style="height: 350px;">
            @if (!string.IsNullOrEmpty(Model?.BannerImageUrl))
            {
                <img src="@Model.BannerImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="@Model.Name" />
            }
            else
            {
                <img src="https://images.unsplash.com/photo-1452626038306-9aae5e071dd3?auto=format&fit=crop&w=1200&q=80"
                     class="w-100 h-100" style="object-fit: cover;" alt="Default Banner" />
            }
            <div class="position-absolute top-0 end-0 m-3">
                <span class="badge badge-lime px-3 py-2 rounded-pill shadow">
                    @Model?.EventType
                </span>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="row g-4">
                <div class="col-lg-7">
                    <h1 class="display-5 fw-bold text-off-white mb-2">@Model?.Name</h1>
                    <p class="text-muted-slate mb-4"><i class="bi bi-person-circle text-lime me-1"></i> Organized by <span class="text-off-white fw-semibold">@Model?.OrganizerName</span></p>

                    <h5 class="fw-bold text-lime mb-2">Event Overview</h5>
                    <p class="text-muted-slate lead fs-6 mb-0">@Model?.Description</p>
                </div>

                <div class="col-lg-5">
                    <div class="box-inner-slate p-4">
                        <h5 class="fw-bold text-off-white mb-3 border-bottom border-secondary pb-2">Race Logistics</h5>

                        <div class="mb-3">
                            <small class="text-muted-slate d-block"><i class="bi bi-calendar-event me-1 text-lime"></i> Date & Time</small>
                            <strong class="text-off-white">@Model?.Date.ToString("dddd, MMMM dd, yyyy @ HH:mm")</strong>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted-slate d-block"><i class="bi bi-geo-alt me-1 text-lime"></i> Venue / Location</small>
                            <strong class="text-off-white">@Model?.Location</strong>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted-slate d-block"><i class="bi bi-speedometer2 me-1 text-lime"></i> Race Distance</small>
                            <strong class="text-off-white">@Model?.Distance km</strong>
                        </div>

                        <div class="mb-4">
                            <small class="text-muted-slate d-block"><i class="bi bi-people me-1 text-lime"></i> Enrolled Participants</small>
                            <strong class="text-off-white fs-5">@Model?.TotalEnrolments Athletes</strong>
                        </div>

                        <form asp-action="RegisterForEvent" method="post">
                            <input type="hidden" name="eventId" value="@Model?.EventId" />
                            <button type="submit" class="btn btn-lime w-100 py-3 shadow">
                                <i class="bi bi-ticket-perforated me-1"></i> Register for Event
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>