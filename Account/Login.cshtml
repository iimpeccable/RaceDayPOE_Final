@model RacingDays.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container my-5" style="max-width: 450px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h3 class="card-title text-center mb-4">Sign In</h3>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3">Sign In</button>
            </form>

            <hr class="my-4" />

            <div class="text-center">
                <p class="small text-muted mb-2">Development Direct Login Bypass:</p>
                <div class="d-grid gap-2">
                    <a asp-action="DevLoginOrganiser" class="btn btn-outline-dark btn-sm">Sign in as Organiser (dummyadmin)</a>
                    <a asp-action="DevLoginParticipant" class="btn btn-outline-secondary btn-sm">Sign in as Participant (dummyparticipant)</a>
                </div>
            </div>
        </div>
    </div>
</div>