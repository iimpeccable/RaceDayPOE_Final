@model IEnumerable<RacingDays.Web.Models.ParticipantRosterViewModel>

@{
    ViewData["Title"] = "Participant Roster";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white m-0"><i class="bi bi-people-fill text-lime me-2"></i>Participant Roster</h2>
            <p class="text-muted mb-0">Registered athletes for <strong class="text-lime">@ViewBag.EventName</strong></p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-lime">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <!-- Live JavaScript Table Filter Input -->
    <div class="mb-3">
        <div class="input-group" style="max-width: 400px;">
            <span class="input-group-text bg-dark border-secondary text-lime"><i class="bi bi-search"></i></span>
            <input type="text" id="tableSearchInput" class="form-control" placeholder="Search athlete name, contact, or category..." />
        </div>
    </div>

    <div class="card card-dark overflow-hidden shadow-lg">
        <div class="table-responsive">
            <table class="table table-dark-custom align-middle mb-0">
                <!-- Update the <thead> to include an Actions column -->
                <thead>
                    <tr>
                        <th>Athlete Name</th>
                        <th>Age</th>
                        <th>Contact Number</th>
                        <th>Email</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th class="text-end">Record Result</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td><strong class="text-off-white">@p.ParticipantName</strong></td>
                                <td><span class="badge bg-secondary">@p.ParticipantAge yrs</span></td>
                                <td>@p.ParticipantContact</td>
                                <td>@p.ParticipantEmail</td>
                                <td><span class="badge badge-lime">@p.CategoryName</span></td>
                                <td><span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>@p.Status</span></td>
                                <td class="text-end">
                                    <a asp-action="CaptureResult"
                                       asp-route-eventId="@ViewBag.EventId"
                                       asp-route-registrationId="@p.RegistrationId"
                                       asp-route-participantName="@p.ParticipantName"
                                       class="btn btn-sm btn-outline-lime">
                                        <i class="bi bi-stopwatch me-1"></i> Record Time
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>