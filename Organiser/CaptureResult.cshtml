@model RacingDays.Web.Models.SubmitResultViewModel

@{
    ViewData["Title"] = "Record Race Result";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-off-white m-0"><i class="bi bi-stopwatch text-lime me-2"></i>Record Race Result</h2>
            <p class="text-muted-slate mb-0">Event: <strong class="text-lime">@Model.EventName</strong></p>
        </div>
        <a asp-action="Participants" asp-route-id="@Model.EventId" class="btn btn-outline-lime">Cancel</a>
    </div>

    <div class="card card-dark p-4 p-md-5 shadow-lg">
        <form asp-action="CaptureResult" method="post">
            <input type="hidden" asp-for="EventId" />
            <input type="hidden" asp-for="RegistrationId" />
            <input type="hidden" asp-for="ParticipantName" />
            <input type="hidden" asp-for="EventName" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label text-off-white fw-bold">Athlete Name</label>
                <input class="form-control" value="@Model.ParticipantName" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="Position" class="form-label text-off-white fw-bold">Finishing Position</label>
                <input asp-for="Position" type="number" min="1" class="form-control" placeholder="e.g. 1" required />
                <span asp-validation-for="Position" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="FinishTimeInput" class="form-label text-off-white fw-bold">Finish Time (HH:mm:ss)</label>
                <input asp-for="FinishTimeInput" class="form-control" placeholder="00:42:15" required />
                <small class="text-muted-slate d-block mt-1">Format: Hours:Minutes:Seconds (e.g. 01:25:30)</small>
                <span asp-validation-for="FinishTimeInput" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-lime w-100 py-3 shadow">
                <i class="bi bi-check-lg me-1"></i> Publish Result
            </button>
        </form>
    </div>
</div>