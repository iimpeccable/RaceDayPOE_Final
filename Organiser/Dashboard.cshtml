@model RacingDays.Web.Models.OrganiserDashboardViewModel

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center my-4">
    <div>
        <h2 class="fw-bold text-off-white m-0"><i class="bi bi-speedometer2 text-lime me-2"></i>Organiser Dashboard</h2>
        <p class="text-muted-slate mb-0">Manage hosted race events and inspect registered athlete rosters</p>
    </div>
    <a asp-action="CreateEvent" class="btn btn-lime shadow">
        <i class="bi bi-plus-lg me-1"></i> Create New Event
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success bg-dark border-lime text-lime alert-dismissible fade show rounded-4 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Summary Metric Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card card-dark p-3">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-uppercase text-muted-slate fw-bold mb-1">Hosted Events</h6>
                    <h2 class="display-5 fw-bold text-lime mb-0">@Model.TotalEventsCreated</h2>
                </div>
                <i class="bi bi-flag display-4 text-lime"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-dark p-3">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-uppercase text-muted-slate fw-bold mb-1">Total Enrolments</h6>
                    <h2 class="display-5 fw-bold text-off-white mb-0">@Model.TotalEnrolments</h2>
                </div>
                <i class="bi bi-people display-4 text-off-white"></i>
            </div>
        </div>
    </div>
</div>

<!-- Events Table -->
<div class="card card-dark overflow-hidden">
    <div class="card-header bg-transparent py-3 border-bottom border-secondary">
        <h5 class="fw-bold text-off-white m-0">Your Events</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-dark-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Event Title</th>
                    <th>Date & Time</th>
                    <th>Registrations</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Events != null && Model.Events.Any())
                {
                    @foreach (var item in Model.Events)
                    {
                        <tr>
                            <td><strong class="text-off-white">@item.Name</strong></td>
                            <td>@item.Date.ToString("MMM dd, yyyy @ HH:mm")</td>
                            <td>
                                @if (item.EventId > 0)
                                {
                                    <a asp-action="Participants" asp-route-id="@item.EventId" class="badge badge-lime text-decoration-none px-3 py-2">
                                        <i class="bi bi-people-fill me-1"></i> @item.TotalEnrolments View Roster
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">0 Enrolments</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="EditEvent" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-lime me-1">Edit</a>
                                <form asp-action="DeleteEvent" asp-route-id="@item.EventId" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted-slate">No events created yet. Click <strong class="text-off-white">Create New Event</strong> above to get started!</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

